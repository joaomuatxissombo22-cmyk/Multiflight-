# GEMINI_API_KEY: Required if optional AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Official production domain or Cloud Run service URL.
APP_URL="https://multiflightangola.com"

# PORT: Server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key used to sign corporate portal authentication tokens
JWT_SECRET="replace-with-strong-production-secret-key"

# CONTACT_RECIPIENT_EMAIL: Target corporate email for inquiries and commercial proposals
CONTACT_RECIPIENT_EMAIL="geral@multiflightangola.com"

# SMTP Configuration (Optional - for Hostinger / Production SMTP relay)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="geral@multiflightangola.com"
SMTP_PASS=""
